# Makevars -- Unix (macOS / Linux) build instructions for R CMD INSTALL
#
# Requirements:
#   - Rust installed (https://rustup.rs)

TARGET_ARCH    = $(shell rustc -vV 2>/dev/null | grep '^host:' | sed 's/host: //')
CARGO_MANIFEST = $(CURDIR)/../Cargo.toml
LIBDIR         = $(CURDIR)/../../target/$(TARGET_ARCH)/release
STATLIB        = $(LIBDIR)/libr_basemapper.a

VENDORED_CORE = $(CURDIR)/rust/core
REPO_CORE     = $(CURDIR)/../../core

PKG_LIBS = -L$(LIBDIR) -lr_basemapper

.PHONY: all clean sync-core

all: $(SHLIB)

$(SHLIB): $(STATLIB)

sync-core:
	if [ -d "$(REPO_CORE)/src" ]; then \
	  mkdir -p "$(VENDORED_CORE)"; \
	  rm -rf "$(VENDORED_CORE)/src" && cp -r "$(REPO_CORE)/src" "$(VENDORED_CORE)/src"; \
	  cp "$(REPO_CORE)/Cargo.toml" "$(VENDORED_CORE)/Cargo.toml"; \
	  if [ -d "$(REPO_CORE)/examples" ]; then \
	    rm -rf "$(VENDORED_CORE)/examples" && cp -r "$(REPO_CORE)/examples" "$(VENDORED_CORE)/examples"; \
	  fi; \
	fi

$(STATLIB): sync-core
	cargo build --release \
	  --target=$(TARGET_ARCH) \
	  --manifest-path="$(CARGO_MANIFEST)" \
	  --target-dir="$(CURDIR)/../../target"

clean:
	rm -Rf $(STATLIB)
